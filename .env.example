# ==============================================================================
# RECRUITER PORTFOLIO - PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this template to .env for local development or set these variables
# in your hosting dashboard (Vercel, Render, Railway, etc.).
# NEVER commit the real .env file or production secrets to source control.
# ==============================================================================

# Server listening port (default: 4173; cloud providers inject PORT automatically)
PORT=4173

# Node execution environment
NODE_ENV=production

# Registered portfolio owner account email
# Exactly ONE owner account is supported.
OWNER_EMAIL=raghavendraraghu71537@gmail.com

# Initial owner password (minimum 10 characters required)
# On startup, the server automatically synchronizes and hashes this value using
# scrypt with a 128-bit cryptographic salt into data/auth.json.
# After first boot, this variable can be removed, and the owner can update
# their password anytime via /admin/settings.
OWNER_PASSWORD=YourStrongPasswordHere123!

# Canonical site domain URL (used for sitemaps and Open Graph metadata)
SITE_URL=https://jraghavendra.dev
